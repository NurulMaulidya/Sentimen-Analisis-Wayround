  "_comment": "Kamus slang dan normalisasi untuk preprocessing ulasan aplikasi",
  "_version": "5.0-FIXED - diperbaiki berdasarkan audit",
  "_notes": [
    "Slang negasi seperti gbs, gabisa diekspansi menjadi token TUNGGAL (bukan spasi)",
    "Token ini nanti akan digabung dengan kata sesudahnya oleh negation handling",
    "Contoh: gbs -> gabs, gabisa -> gabisa, handle_negation -> gabs_bisa",
    "PENTING: Hapus multi-word string dengan spasi karena memecah negasi!"
  ],
  "_rules": {
    "1_slash_expansion": "Slang diekspansi ke SATU token (underscore jika perlu untuk negasi)",
    "2_negation": "handle_negation menggabungkan token negasi dengan kata sesudahnya",
    "3_underscore_protection": "Token dengan underscore TIDAK dipisah kembali"
  },

  "_removed_multi_word_bugs": {
    "_comment": "ENTRI BERIKUT DIHAPUS KARENA MEMECAH NEGASI:",
    "_gbs": "gbs -> [tidak bisa] (LIST) - DIPERBAIKI jadi single token",
    "_gabisa": "gabisa -> [tidak bisa] (LIST) - DIPERBAIKI jadi single token",
    "_fix": "Gunakan array untuk multi-token agar TIDAK di-join dengan spasi"
  },

  "_audit_2026_10_13": {
    "status": "FIXED",
    "changes": [
      "Hapus multi-word string dengan spasi",
      "Gunakan underscore untuk mempertahankan negasi",
      "Tambahkan slang baru yang umum di dataset"
    ]
  },

